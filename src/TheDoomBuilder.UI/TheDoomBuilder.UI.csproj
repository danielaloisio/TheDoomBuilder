<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- The project/folder name tracks the product name; the C# namespace and assembly name stay as they were. -->
    <RootNamespace>DoomBuilder.UI</RootNamespace>
    <AssemblyName>DoomBuilder.UI</AssemblyName>
  </PropertyGroup>

  <!-- Avalonia controls and helpers shared by the app and the plugins (texture/flat selectors, image browser, dialog pump). -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheDoomBuilder.Core\TheDoomBuilder.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TheDoomBuilder.App" />
    <InternalsVisibleTo Include="TheDoomBuilder.App.Tests" />
  </ItemGroup>
</Project>

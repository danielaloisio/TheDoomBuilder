<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DoomBuilder.App"
        x:Class="DoomBuilder.App.MainWindow"
        Width="900" Height="600"
        Title="DoomBuilder - Fase 0">
    <DockPanel>
        <TextBlock x:Name="InfoText" DockPanel.Dock="Bottom" Margin="8" TextWrapping="Wrap" Text="Aguardando contexto OpenGL..." />
        <local:MapViewport x:Name="Viewport" />
    </DockPanel>
</Window>

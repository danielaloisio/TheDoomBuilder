<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DoomBuilder.App"
        x:Class="DoomBuilder.App.MainWindow"
        Width="1100" Height="750"
        Title="TheDoomBuilder">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <TextBlock x:Name="StatusText" Text="Starting..." />
        </Border>
        <local:MapViewport x:Name="Viewport" />
    </DockPanel>
</Window>

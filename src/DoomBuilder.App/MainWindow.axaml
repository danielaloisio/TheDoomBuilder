<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DoomBuilder.App"
        x:Class="DoomBuilder.App.MainWindow"
        Width="1100" Height="750"
        Title="TheDoomBuilder">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="HintsText" DockPanel.Dock="Right" Margin="16,0,0,0" Opacity="0.7" TextWrapping="NoWrap" />
                <TextBlock x:Name="StatusText" Text="Starting..." />
            </DockPanel>
        </Border>
        <!-- The transparent panel is what receives the pointer: a GL control is not hit-testable on its own -->
        <Panel x:Name="InputSurface" Background="Transparent">
            <local:MapViewport x:Name="Viewport" />
        </Panel>
    </DockPanel>
</Window>

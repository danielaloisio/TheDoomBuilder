<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- The editor's game configurations, scripts, snippets, sprites... (the same layout UDB ships next to its executable) -->
  <ItemGroup>
    <Content Include="..\..\assets\Common\**\*" Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Platform folder: compiler/nodebuilder configurations. macOS uses the Unix layout until it gets its own tools. -->
    <Content Include="..\..\assets\Linux\**\*" Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
    <Content Include="..\..\assets\Windows\**\*" Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <Content Include="..\..\assets\samples\*" Link="samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
    <PackageReference Include="Semi.Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DoomBuilder.Rendering\DoomBuilder.Rendering.csproj" />
    <ProjectReference Include="..\Plugins\BuilderModes\BuilderModes.csproj" />
    <ProjectReference Include="..\Plugins\ThreeDFloorMode\ThreeDFloorMode.csproj" />
    <ProjectReference Include="..\Plugins\StairSectorBuilder\StairSectorBuilder.csproj" />
    <ProjectReference Include="..\Plugins\SoundPropagationMode\SoundPropagationMode.csproj" />
    <ProjectReference Include="..\Plugins\WadAuthorMode\WadAuthorMode.csproj" />
    <ProjectReference Include="..\Plugins\USDF\USDF.csproj" />
    <ProjectReference Include="..\Plugins\ImageDrawingExample\ImageDrawingExample.csproj" />
    <ProjectReference Include="..\Plugins\UDBScript\UDBScript.csproj" />
    <ProjectReference Include="..\Plugins\BuilderEffects\BuilderEffects.csproj" />
    <ProjectReference Include="..\Plugins\ColorPicker\ColorPicker.csproj" />
    <ProjectReference Include="..\Plugins\AutomapMode\AutomapMode.csproj" />
    <ProjectReference Include="..\Plugins\VisplaneExplorer\VisplaneExplorer.csproj" />
    <ProjectReference Include="..\Plugins\NodesViewer\NodesViewer.csproj" />
    <ProjectReference Include="..\Plugins\RejectExplorer\RejectExplorer.csproj" />
    <ProjectReference Include="..\Plugins\BlockmapExplorer\BlockmapExplorer.csproj" />
    <ProjectReference Include="..\Plugins\TagExplorer\TagExplorer.csproj" />
    <ProjectReference Include="..\Plugins\TagRange\TagRange.csproj" />
    <ProjectReference Include="..\Plugins\CommentsPanel\CommentsPanel.csproj" />
    <ProjectReference Include="..\DoomBuilder.Core\DoomBuilder.Core.csproj" />
    <ProjectReference Include="..\DoomBuilder.UI\DoomBuilder.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Actions.cfg" />
    <EmbeddedResource Include="Resources\mainform-ui.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DoomBuilder.App.Tests" />
  </ItemGroup>

</Project>

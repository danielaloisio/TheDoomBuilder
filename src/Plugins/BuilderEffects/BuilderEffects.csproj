<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>CodeImp.DoomBuilder.BuilderEffects</RootNamespace>
    <!-- Actions are "<assembly>_<action>": the name is part of the user's saved shortcuts -->
    <AssemblyName>BuilderEffects</AssemblyName>
    <DefineConstants>$(DefineConstants);NO_WIN32;NO_UPDATER;NO_SCINTILLA;NO_FORMS_DESIGN</DefineConstants>
    <NoWarn>$(NoWarn);CA2022;CS0067;CS0618;CS0649;CS0169;CS0414;CS0108;CS0659;CS0661;CA1416;CS0219;CS0168</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DoomBuilder.Core\DoomBuilder.Core.csproj" />
    <ProjectReference Include="..\..\DoomBuilder.UI\DoomBuilder.UI.csproj" />

    <PackageReference Include="Avalonia" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DoomBuilder.App" />
    <InternalsVisibleTo Include="DoomBuilder.App.Tests" />
    <InternalsVisibleTo Include="DoomBuilder.Core.Tests" />
  </ItemGroup>

</Project>
